---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Leaf from '../../components/illustrations/Leaf.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const allPosts = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---
<BaseLayout active="" title={`${post.data.title} · HarvestMap`} description={post.data.description}>
  <div class="container" style="padding-top: var(--space-6); max-width: 72ch;">
    <a href="/blog" class="btn btn--ghost" style="margin-bottom: var(--space-4);">&larr; All posts</a>

    <header style="margin-bottom: var(--space-6);">
      <div class="cluster" style="margin-bottom: var(--space-3);">
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <h1 class="squiggle squiggle-ember">{post.data.title}</h1>
      <p class="lead" style="margin-top: var(--space-3);">{post.data.description}</p>
      <p style="color: var(--text-muted); font-size: var(--fs-small); margin-top: var(--space-3);">
        {formatDate(post.data.publishDate)} · by {post.data.author}
      </p>
    </header>

    <article class="prose" style="max-width: 100%;">
      <Content />
    </article>

    {allPosts.length > 0 && (
      <div style="margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--line);">
        <span class="eyebrow" style="display: block; margin-bottom: var(--space-4);">More from the blog</span>
        <div class="seed-grid">
          {allPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="card" style="text-decoration: none;">
              <div class="card__body">
                <h3 class="card__title" style="font-size: var(--fs-body); font-family: var(--font-display);">{p.data.title}</h3>
                <p class="card__desc" style="font-size: var(--fs-small);">{p.data.description}</p>
              </div>
              <div class="card__foot">
                <span class="card__loc">{formatDate(p.data.publishDate)}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
