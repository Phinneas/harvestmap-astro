---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Leaf from '../../components/illustrations/Leaf.astro';
---
<BaseLayout active="blog" title="Blog · HarvestMap" description="Guides, seasonal updates, and stories from farms across America.">
  <div class="container" style="padding-top: var(--space-7);">
    <div class="section-head" style="max-width: 60ch; margin-bottom: var(--space-7);">
      <span class="eyebrow"><Leaf class="is-drawn" style="width:18px;height:18px;" /> From the field</span>
      <h1>Blog</h1>
      <p class="lead">Seasonal guides, farm stories, and what's picking across the country. Coming soon.</p>
    </div>

    <div class="panel" style="padding: var(--space-6); text-align: center; max-width: 50ch; margin: 0 auto;">
      <p style="color: var(--text-muted); margin: 0;">
        We're gathering stories from growers and writing seasonal guides. Check back soon, or
        <a href="/#directory" style="color: var(--clay-deep);">browse farms</a> in the meantime.
      </p>
    </div>
  </div>
</BaseLayout>
