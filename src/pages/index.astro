---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonalBanner from '../components/SeasonalBanner.astro';
import SearchBar from '../components/SearchBar.astro';
import FarmCard from '../components/FarmCard.astro';
import EmptyState from '../components/EmptyState.astro';
import Button from '../components/Button.astro';
import PathLine from '../components/illustrations/PathLine.astro';
import Leaf from '../components/illustrations/Leaf.astro';
import PeachCrossSection from '../components/illustrations/PeachCrossSection.astro';
import Basket from '../components/illustrations/Basket.astro';
import PruningShears from '../components/illustrations/PruningShears.astro';
import Foragers from '../components/illustrations/Foragers.astro';
import Mushrooms from '../components/illustrations/Mushrooms.astro';
import { loadAllAugmentedFarms, loadEnrichedAugmentedFarms, getStatesWithFarms } from '../lib/farm-loader';

const allFarms = loadAllAugmentedFarms();
const enrichedFarms = loadEnrichedAugmentedFarms();
const states = getStatesWithFarms();

const total = allFarms.length;
const inSeason = enrichedFarms.filter((f) => f.derivedInSeasonNow).length;
const withCrops = enrichedFarms.length;
const enriched = enrichedFarms.filter((f) => f.isEnriched).length;
const countFor = (k: string) => enrichedFarms.filter((f) => (f.seasons || f.derivedSeasons).includes(k as any)).length;

// "What's ripe this week" — farms with a recent lastConfirmedAt (within 30 days)
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const recentlyConfirmed = enrichedFarms
  .filter((f) => f.lastConfirmedAt && new Date(f.lastConfirmedAt) >= thirtyDaysAgo)
  .sort((a, b) => new Date(b.lastConfirmedAt!).getTime() - new Date(a.lastConfirmedAt!).getTime());

const confirmedCount = recentlyConfirmed.length;
const topConfirmed = recentlyConfirmed.slice(0, 5);
const confirmedNames = topConfirmed.map((f) => f.name);
const bannerText = confirmedCount > 0
  ? `${confirmedCount} ${confirmedCount === 1 ? 'farm was' : 'farms were'} confirmed harvesting this week${confirmedNames.length > 0 ? ' — ' + confirmedNames.slice(0, 3).join(', ') + (confirmedNames.length > 3 ? ' and more' : '') : ''}.`
  : `${inSeason} of ${total} growers are in season right now. Help us confirm what's ripe — report from any farm page.`;
const bannerEyebrow = confirmedCount > 0
  ? 'Updated this week · community-confirmed'
  : 'This season · find what\'s ripe near you';
---
<BaseLayout active="home">
  <!-- Hero -->
  <div class="container" style="padding-top: var(--space-7);">
    <SeasonalBanner
      eyebrow={bannerEyebrow}
      text={bannerText}
    />
    <div class="cluster" style="justify-content:center; gap:var(--space-6); margin-top:var(--space-5); color:var(--text-muted); font-size:var(--fs-small);">
      <span><b style="color:var(--clay-deep)">{total}</b> farms listed</span>
      <span aria-hidden="true">·</span>
      <span><b style="color:var(--clay-deep)">{withCrops}</b> with crop data</span>
      <span aria-hidden="true">·</span>
      <span><b style="color:var(--clay-deep)">{enriched}</b> fully enriched</span>
      {confirmedCount > 0 && (
        <>
          <span aria-hidden="true">·</span>
          <span><b style="color:var(--moss)">{confirmedCount}</b> confirmed this week</span>
        </>
      )}
    </div>

    <!-- Recently confirmed farms strip -->
    {confirmedCount > 0 && (
      <div class="container" style="margin-top: var(--space-5);">
        <div class="cluster" style="gap: var(--space-3); flex-wrap: wrap;">
          {topConfirmed.map((f) => (
            <a href={`/farms/${f.slug}`} class="panel" style="padding: var(--space-2) var(--space-4); text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-2); border-color: var(--moss);">
              <span class="badge__dot" style="background: var(--moss);"></span>
              <span style="font-weight: 600; color: var(--ink);">{f.name}</span>
              {f.derivedInSeasonNow && <span style="font-size: var(--fs-small); color: var(--moss);">harvesting now</span>}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Directory -->
  <section class="section" id="directory">
    <div class="container">
      <div class="section-head split">
        <div class="stack stack-3" style="max-width:46ch;">
          <span class="eyebrow">
            <Leaf class="is-drawn" style="width:18px;height:18px;" /> Browse the directory
          </span>
          <h2>Farms harvesting near you</h2>
          <p class="lead">{inSeason} of {withCrops} enriched growers are in season right now. {total} farms in our national database — browse by state below.</p>
        </div>
        <div style="flex:1; min-width:min(100%, 340px); max-width:480px;">
          <SearchBar />
        </div>
      </div>

      <div class="seed-grid stagger" id="farm-grid" style="margin-top: var(--space-7);">
        {enrichedFarms.map((f) => <FarmCard farm={f} />)}
      </div>

      <EmptyState id="farm-empty" class="is-hidden" />
    </div>
  </section>

  <!-- State directory -->
  <section class="section" id="states">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Browse by state</span>
        <h2>{total} farms across {states.length} states</h2>
        <p class="lead">Pick a state to see all farms, farmers markets, CSAs, and agritourism listings in our database.</p>
      </div>
      <div class="state-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-3); margin-top: var(--space-5);">
        {states.map((s) => (
          <a href={`/${s.code.toLowerCase()}`} class="panel" style="padding: var(--space-3) var(--space-4); text-decoration: none; transition: transform 0.15s, box-shadow 0.15s;">
            <div style="font-weight: 700; font-size: var(--fs-body); color: var(--ink);">{s.name}</div>
            <div style="font-size: var(--fs-small); color: var(--text-muted); margin-top: 2px;">
              {s.count} farms{s.enriched > 0 ? ` · ${s.enriched} enriched` : ''}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Hand-drawn divider -->
  <div class="container" aria-hidden="true">
    <div class="divider">
      <span class="divider__seed"><Leaf /></span>
      <PathLine class="is-drawn" />
      <span class="divider__seed"><Leaf /></span>
    </div>
  </div>

  <!-- Season guide -->
  <section class="section" id="seasons">
    <div class="container relative">
      <div class="section-head">
        <span class="eyebrow">The season guide</span>
        <h2>What’s ripe, by season</h2>
        <p class="lead">Eat with the calendar. Here’s the rhythm of the year across our growers — tap a season to find who’s harvesting.</p>
      </div>

      <div class="season-grid">
        <!-- Spring -->
        <article class="panel season-panel" style="--accent: var(--season-spring);">
          <div class="season-panel__head">
            <h3><span class="badge__dot" style="background:var(--accent)"></span> Spring</h3>
            <Leaf class="deco-ill" />
          </div>
          <ul>
            <li><span>Asparagus</span><span class="mo">Mar – May</span></li>
            <li><span>Cutting lettuces</span><span class="mo">Apr – Jun</span></li>
            <li><span>Strawberries</span><span class="mo">May – Jun</span></li>
            <li><span>Peas &amp; herbs</span><span class="mo">Apr – Jun</span></li>
          </ul>
          <Button variant="ghost" href="#directory">{countFor('spring')} farms in spring →</Button>
        </article>

        <!-- Summer -->
        <article class="panel season-panel" style="--accent: var(--season-summer);">
          <div class="season-panel__head">
            <h3><span class="badge__dot" style="background:var(--accent)"></span> Summer</h3>
            <PeachCrossSection class="deco-ill" />
          </div>
          <ul>
            <li><span>Apricots</span><span class="mo">June</span></li>
            <li><span>Peaches &amp; nectarines</span><span class="mo">Jul – Aug</span></li>
            <li><span>Berries</span><span class="mo">Jun – Aug</span></li>
            <li><span>Sweet corn</span><span class="mo">August</span></li>
          </ul>
          <Button variant="ghost" href="#directory">{countFor('summer')} farms in summer →</Button>
        </article>

        <!-- Autumn -->
        <article class="panel season-panel" style="--accent: var(--season-autumn);">
          <div class="season-panel__head">
            <h3><span class="badge__dot" style="background:var(--accent)"></span> Autumn</h3>
            <Basket class="deco-ill" />
          </div>
          <ul>
            <li><span>Heirloom apples</span><span class="mo">Sep – Nov</span></li>
            <li><span>Winter squash</span><span class="mo">Oct – Dec</span></li>
            <li><span>Chanterelles</span><span class="mo">Sep – Dec</span></li>
            <li><span>Pears &amp; quince</span><span class="mo">Sep – Oct</span></li>
          </ul>
          <Button variant="ghost" href="#directory">{countFor('autumn')} farms in autumn →</Button>
        </article>

        <!-- Winter -->
        <article class="panel season-panel" style="--accent: var(--season-winter);">
          <div class="season-panel__head">
            <h3><span class="badge__dot" style="background:var(--accent)"></span> Winter</h3>
            <PruningShears class="deco-ill" />
          </div>
          <ul>
            <li><span>Citrus</span><span class="mo">Dec – Feb</span></li>
            <li><span>Hardy greens</span><span class="mo">Nov – Feb</span></li>
            <li><span>Barrel cider</span><span class="mo">Dec – Mar</span></li>
            <li><span>Storage roots</span><span class="mo">Nov – Feb</span></li>
          </ul>
          <Button variant="ghost" href="#directory">{countFor('winter')} farms in winter →</Button>
        </article>
      </div>
    </div>
  </section>

  <!-- Grower CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div class="stack stack-4">
          <span class="eyebrow">For growers</span>
          <h2>Grow it? Put your farm on the map.</h2>
          <p class="lead">List your stand, keep your harvest current, and let neighbours find you when your fruit is at its peak. Free for small farms, forever.</p>
          <div class="cluster">
            <Button variant="primary" size="lg" href="/add-farm">List your farm</Button>
            <Button variant="secondary" size="lg" href="#directory">How it works</Button>
          </div>
        </div>
        <div class="cta-band__art">
          <Foragers class="is-drawn" label="Two growers gathering fruit" />
        </div>
      </div>
    </div>
  </section>

  <!-- Season filtering (client-side) + text search redirect to /search -->
  <script is:inline>
    (function () {
      var grid = document.getElementById('farm-grid');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.children);
      var empty = document.getElementById('farm-empty');
      var input = document.getElementById('farm-search');
      var chips = Array.prototype.slice.call(document.querySelectorAll('.chip[data-filter]'));
      var season = 'all';

      // Season filter: pure client-side, filters farm cards by data-seasons
      function applySeason() {
        var n = 0;
        cards.forEach(function (c) {
          var s = c.getAttribute('data-seasons') || '';
          var show = season === 'all' || s.indexOf(season) > -1;
          c.classList.toggle('is-hidden', !show);
          if (show) n++;
        });
        if (empty) empty.classList.toggle('is-hidden', n !== 0);
      }

      chips.forEach(function (ch) {
        ch.addEventListener('click', function () {
          chips.forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
          ch.setAttribute('aria-pressed', 'true');
          season = ch.getAttribute('data-filter');
          applySeason();
        });
      });

      // Text search: redirect to /search for full-text Pagefind search
      function redirectToSearch() {
        var q = input ? input.value.trim() : '';
        if (q) window.location.href = '/search?q=' + encodeURIComponent(q);
      }

      if (input) {
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); redirectToSearch(); }
        });
      }
      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-search-go]')) { redirectToSearch(); }
        if (e.target.closest('[data-clear-filters]')) {
          season = 'all'; if (input) input.value = '';
          chips.forEach(function (x) { x.setAttribute('aria-pressed', x.getAttribute('data-filter') === 'all' ? 'true' : 'false'); });
          applySeason();
        }
      });
    })();
  </script>
</BaseLayout>
