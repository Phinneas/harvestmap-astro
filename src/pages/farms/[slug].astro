---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeasonBadge from '../../components/SeasonBadge.astro';
import Button from '../../components/Button.astro';
import FarmRow from '../../components/FarmRow.astro';
import PathLine from '../../components/illustrations/PathLine.astro';
import Leaf from '../../components/illustrations/Leaf.astro';
import { augmentFarm } from '../../lib/augment';
import type { Farm } from '../../lib/types';

// --- SSR data loading ---
// Farm data is served as static JSON files in /farm-data/.
// The index maps slug → state code, and each state file has all farms for that state.

const { slug } = Astro.params;
if (!slug) return new Response('Not found', { status: 404 });

// Cache the slug→state index in module scope (persists across requests on same isolate)
type FarmIndex = Record<string, string>;
let _farmIndex: FarmIndex | null = null;

async function getFarmIndex(): Promise<FarmIndex> {
  if (_farmIndex) return _farmIndex;
  const runtime = (Astro as any).locals.runtime;
  if (!runtime?.env?.ASSETS) throw new Error('ASSETS binding not available');
  const res = await runtime.env.ASSETS.fetch(new URL('/farm-data/index.json', Astro.url));
  _farmIndex = await res.json();
  return _farmIndex;
}

async function getStateFarms(stateCode: string): Promise<Farm[]> {
  const runtime = (Astro as any).locals.runtime;
  const res = await runtime.env.ASSETS.fetch(new URL(`/farm-data/${stateCode.toLowerCase()}.json`, Astro.url));
  return await res.json();
}

// Load farm data
const index = await getFarmIndex();
const stateCode = index[slug];
if (!stateCode) return new Response('Not found', { status: 404 });

const stateFarms: Farm[] = await getStateFarms(stateCode);
const farmData = stateFarms.find((f) => f.slug === slug);
if (!farmData) return new Response('Not found', { status: 404 });

const farm = augmentFarm(farmData);

// Edge cache: 1hr fresh, 24hr stale-while-revalidate. Farm data changes monthly;
// the refresh script purges Cloudflare cache after updating.
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400');

// Related farms: same state, overlapping seasons (no need to load all 27k farms)
const augmentedState = stateFarms.map(augmentFarm);
const related = augmentedState
  .filter((f) => f.slug !== farm.slug)
  .filter((f) => {
    const fSeasons = f.seasons && f.seasons.length > 0 ? f.seasons : f.derivedSeasons;
    const farmSeasons = farm.seasons && farm.seasons.length > 0 ? farm.seasons : farm.derivedSeasons;
    return farmSeasons.some((s: string) => fSeasons.includes(s as any));
  })
  .slice(0, 3);

// Gallery: only built from real farm photos in the same state. No placeholder fallback —
// if no real images exist, the gallery section is skipped entirely.
const PLACEHOLDER = '/images/farm-placeholder.svg';
const hasRealImage = !!(farm.image && farm.image !== PLACEHOLDER);
const enrichedStateImages = augmentedState
  .map((f) => f.image)
  .filter((src): src is string => !!src && src !== PLACEHOLDER);
const farmIdx = augmentedState.findIndex((f) => f.slug === farm.slug);
const gallery = enrichedStateImages.length >= 3
  ? [
      enrichedStateImages[(farmIdx + 1) % enrichedStateImages.length],
      enrichedStateImages[(farmIdx + 2) % enrichedStateImages.length],
      enrichedStateImages[(farmIdx + 3) % enrichedStateImages.length],
    ]
  : (hasRealImage ? [farm.image!] : []);

const peakLabels: Record<string, string> = { spring: 'Spring', summer: 'Summer', autumn: 'Autumn', winter: 'Winter', year: 'Year-round' };

const seasons = farm.seasons && farm.seasons.length > 0 ? farm.seasons : farm.derivedSeasons;
const peak = farm.peak || farm.derivedPeak;
const inSeasonNow = farm.inSeasonNow !== undefined ? farm.inSeasonNow : farm.derivedInSeasonNow;
const calendar = farm.calendar && farm.calendar.length > 0 ? farm.calendar : farm.derivedCalendar;
const produce = farm.produce || farm.crops || [];
const image = farm.image;
const imageAlt = farm.imageAlt || farm.name;
const tagline = farm.tagline || (produce.length > 0 ? `U-pick: ${produce.slice(0, 3).join(', ')}` : 'Farm listing');
const region = farm.region || farm.directory;

const isEnriched = farm.isEnriched;
const hasCalendar = calendar.length > 0;
const hasDescription = farm.description && farm.description.length > 0;
const hasPractices = farm.practices && farm.practices.length > 0;

// Thin content check: noindex pages with no enrichment data to avoid SERP penalties
const hasRichContent = isEnriched || produce.length > 0 || hasDescription || hasPractices ||
  hasRealImage || !!farm.website;

const typeLabels: Record<string, string> = {
  agritourism: 'Agritourism', farmersmarket: "Farmers' Market", csa: 'CSA',
  foodhub: 'Food Hub', onfarmmarket: 'On-Farm Market', editorial: 'Featured',
};
const typeLabel = typeLabels[farm.directory] || '';
const showTypeBadge = farm.directory !== 'agritourism' && farm.directory !== 'editorial';
const hasEstablished = farm.established !== undefined;
---
<BaseLayout active="farms" title={`${farm.name} · HarvestMap`} description={tagline} noindex={!hasRichContent}>
  <div class="container" style="padding-top: var(--space-6);">
    <a href="/#finder" class="btn btn--ghost" style="margin-bottom: var(--space-4);">&larr; All farms</a>

    {/* Hero: real photo if one exists, otherwise a text header with the location map. */}
    {hasRealImage ? (
      <header class="detail-hero">
        <img src={image} alt={imageAlt} width="1400" height="800" />
        <div class="detail-hero__content">
          <span class="eyebrow" style="color: var(--honey);">{region}{showTypeBadge && <span class={`type-badge type-badge--${farm.directory}`}>{typeLabel}</span>}</span>
          <h1 class="squiggle squiggle-ember">{farm.name}</h1>
          <div class="cluster">
            {seasons.map((s) => <SeasonBadge season={s} label={s === peak ? `${peakLabels[s]} peak` : peakLabels[s]} />)}
            <span class="card__loc" style="color: rgba(255,247,236,0.92);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--honey)">
                <path d="M12 21c5-3 8-7 8-11a8 8 0 1 0-16 0c0 4 3 8 8 11Z"/><circle cx="12" cy="10" r="2.6"/>
              </svg>
              {farm.location}
            </span>
          </div>
        </div>
      </header>
    ) : (
      <header class="detail-hero detail-hero--plain">
        <div class="detail-hero__content detail-hero__content--plain">
          <span class="eyebrow" style="color: var(--clay);">{region}{showTypeBadge && <span class={`type-badge type-badge--${farm.directory}`}>{typeLabel}</span>}</span>
          <h1 class="squiggle squiggle-ember" style="color: var(--ink);">{farm.name}</h1>
          <div class="cluster">
            {seasons.map((s) => <SeasonBadge season={s} label={s === peak ? `${peakLabels[s]} peak` : peakLabels[s]} />)}
            <span class="card__loc">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--clay)">
                <path d="M12 21c5-3 8-7 8-11a8 8 0 1 0-16 0c0 4 3 8 8 11Z"/><circle cx="12" cy="10" r="2.6"/>
              </svg>
              {farm.location}
            </span>
          </div>
          {farm.lat && farm.lon && (
            <div id="farm-map" class="detail-hero__map" role="img" aria-label={`Map showing ${farm.name} location`}></div>
          )}
        </div>
      </header>
    )}

    {farm.permanentlyClosed && (
      <div class="callout callout--warning" style="margin-top: var(--space-4); padding: var(--space-4); border-radius: var(--radius-md); background: var(--ember-15); border: 1px solid var(--ember);">
        <strong style="color: var(--ember);">Permanently closed.</strong>
        <span style="color: var(--text-muted);"> This farm may no longer be operating. Listing retained for reference.</span>
      </div>
    )}

    <!-- Body -->
    <div class="detail-layout section--tight">
      <div class="stack stack-6" style="gap: var(--space-7);">
        {/* Stats row — only show fields that exist */}
        {(hasEstablished || produce.length > 0 || peak) && (
          <div class="stats-row">
            {hasEstablished && (
              <div class="stat"><span class="stat__num">{farm.established}</span><span class="stat__lbl">Established</span></div>
            )}
            {produce.length > 0 && (
              <div class="stat"><span class="stat__num">{produce.length}</span><span class="stat__lbl">Crops in rotation</span></div>
            )}
            {peak && (
              <div class="stat"><span class="stat__num">{peakLabels[peak]}</span><span class="stat__lbl">Peak season</span></div>
            )}
          </div>
        )}

        {/* Description — only for enriched farms */}
        {hasDescription && (
          <div class="prose">
            {farm.description!.map((para) => <p>{para}</p>)}
          </div>
        )}

        {/* Not-enriched notice for USDA-only farms */}
        {!isEnriched && (
          <div class="panel" style="padding: var(--space-4); border-style: dashed;">
            <p style="color: var(--text-muted); margin: 0;">
              This farm is listed from USDA local food directory data. Detailed seasonality, photos, and growing practices haven’t been enriched yet.
              {farm.website && <> Visit <a href={farm.website} rel="noopener">{farm.website}</a> for more info.</>}
            </p>
          </div>
        )}

        {/* What's in season — show if we have any calendar data */}
        {hasCalendar && (
          <section class="panel panel--feature">
            <div class="split" style="margin-bottom: var(--space-4);">
              <h3 style="display:flex;align-items:center;gap:var(--space-2);"><Leaf style="width:22px;height:22px;color:var(--moss);" /> What’s in season</h3>
              {inSeasonNow && peak && <SeasonBadge season={peak} label="Harvesting now" />}
            </div>
            <ul class="cal">
              {calendar.map((c) => (
                <li>
                  <span class="cal__name"><a href={`/crops/${c.name.toLowerCase().replace(/\s+/g, '-')}`} style="color: inherit; text-decoration: none;">{c.name}</a></span>
                  <span class="cluster" style="gap: var(--space-3);">
                    <span class="cal__months">{c.months}</span>
                    <SeasonBadge season={c.season as any} />
                  </span>
                </li>
              ))}
            </ul>
            {!farm.calendar && (
              <p style="font-size: var(--fs-small); color: var(--text-muted); margin-top: var(--space-3); margin-bottom: 0;">
                Seasonal availability estimated from crop calendars for this climate zone.
              </p>
            )}
          </section>
        )}

        {/* Gallery — only when real farm photos exist (never a placeholder). */}
        {gallery.length > 0 && (
          <div class="stack stack-3">
            <span class="eyebrow">From the farm</span>
            <div class="gallery">
              {gallery.map((src, i) => <img src={src} alt={`${farm.name} harvest ${i + 1}`} width="500" height="500" loading="lazy" decoding="async" />)}
            </div>
          </div>
        )}
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
        <div class="panel panel--feature">
          <h3 style="margin-bottom: var(--space-3);">Plan a visit</h3>
          {hasRealImage && farm.lat && farm.lon && (
            <div id="farm-map" style="height:200px; border-radius:var(--radius-md); overflow:hidden; border:1px solid var(--line); margin-bottom:var(--space-4);"></div>
          )}
          <ul class="cal" style="margin-bottom: var(--space-4);">
            {farm.stand && (
              <li><span class="cal__name">Hours</span><span class="cal__months" style="text-align:right;max-width:60%;">{farm.stand}</span></li>
            )}
            <li><span class="cal__name">Region</span><span class="cal__months">{region}</span></li>
            {farm.website && (
              <li><span class="cal__name">Website</span><span class="cal__months"><a href={farm.website} rel="noopener" style="color: var(--clay-deep);">Visit →</a></span></li>
            )}
            {farm.phone && (
              <li><span class="cal__name">Phone</span><span class="cal__months">{farm.phone}</span></li>
            )}
            {farm.email && (
              <li><span class="cal__name">Email</span><span class="cal__months"><a href={`mailto:${farm.email}`} style="color: var(--clay-deep);">{farm.email}</a></span></li>
            )}
          </ul>
          <div class="stack stack-2">
            {farm.lat && farm.lon ? (
              <Button variant="primary" block href={`https://www.openstreetmap.org/?mlat=${farm.lat}&mlon=${farm.lon}#map=14/${farm.lat}/${farm.lon}`} target="_blank" rel="noopener">Get directions</Button>
            ) : (
              <Button variant="primary" block href="#">Get directions</Button>
            )}
            <Button variant="secondary" block id="save-farm-btn" data-slug={farm.slug}>Save to my map</Button>
            <Button variant="ghost" block href={`/report?farm=${farm.slug}&name=${encodeURIComponent(farm.name)}`}>Report what's ripe</Button>
          </div>
        </div>

        {/* Practices — only for enriched farms */}
        {hasPractices && (
          <div class="panel">
            <span class="eyebrow" style="margin-bottom: var(--space-3); display:block;">How they grow</span>
            <ul class="list-checks">
              {farm.practices!.map((p) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <div class="container" aria-hidden="true">
    <div class="divider"><span class="divider__seed"><Leaf /></span><PathLine class="is-drawn" /><span class="divider__seed"><Leaf /></span></div>
  </div>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Keep exploring</span>
          <h2>More farms in season</h2>
        </div>
        <div class="farm-list">
          {related.map((f) => <FarmRow farm={f} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<!-- JSON-LD structured data for Google rich results -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': farm.directory === 'farmersmarket' ? 'Store' : 'LocalBusiness',
  name: farm.name,
  description: tagline,
  address: {
    '@type': 'PostalAddress',
    addressLocality: farm.locationCity,
    addressRegion: farm.locationState,
    postalCode: farm.locationZipcode,
    addressCountry: 'US',
  },
  ...(farm.lat && farm.lon ? {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: farm.lat,
      longitude: farm.lon,
    },
  } : {}),
  ...(farm.website ? { url: farm.website } : {}),
  ...(farm.phone ? { telephone: farm.phone } : {}),
  ...(produce.length > 0 ? { makesOffer: produce.map((crop) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Product', name: crop },
  })) } : {}),
})} />

<!-- Breadcrumb structured data -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: farm.locationState, item: `/${farm.locationState.toLowerCase()}` },
    { '@type': 'ListItem', position: 3, name: farm.name, item: `/farms/${farm.slug}` },
  ],
})} />

<!-- Leaflet map for farm location -->
{farm.lat && farm.lon && (
  <script is:inline>
    (function () {
      var mapEl = document.getElementById('farm-map');
      if (!mapEl) return;
      var lat = {farm.lat}, lon = {farm.lon};

      function initMap() {
        if (typeof L === 'undefined') {
          setTimeout(initMap, 100);
          return;
        }
        var map = L.map('farm-map', { scrollWheelZoom: false }).setView([lat, lon], 13);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 18,
        }).addTo(map);
        L.marker([lat, lon]).addTo(map);
      }

      if (typeof L === 'undefined') {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(link);
        var s = document.createElement('script');
        s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        s.onload = initMap;
        document.head.appendChild(s);
      } else {
        initMap();
      }
    })();
  </script>
)}

<!-- Save to my map — localStorage favorites -->
<script is:inline>
  (function () {
    var btn = document.getElementById('save-farm-btn');
    if (!btn) return;
    var slug = btn.dataset.slug;
    var key = 'harvestmap:favorites';
    var favs = JSON.parse(localStorage.getItem(key) || '[]');
    var idx = favs.indexOf(slug);
    if (idx >= 0) { btn.textContent = 'Saved ✓'; btn.classList.add('is-saved'); }

    btn.addEventListener('click', function () {
      favs = JSON.parse(localStorage.getItem(key) || '[]');
      idx = favs.indexOf(slug);
      if (idx >= 0) {
        favs.splice(idx, 1);
        btn.textContent = 'Save to my map';
        btn.classList.remove('is-saved');
      } else {
        favs.push(slug);
        btn.textContent = 'Saved ✓';
        btn.classList.add('is-saved');
      }
      localStorage.setItem(key, JSON.stringify(favs));
    });
  })();
</script>
