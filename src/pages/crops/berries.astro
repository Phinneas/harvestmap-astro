---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FarmRow from '../../components/FarmRow.astro';
import Leaf from '../../components/illustrations/Leaf.astro';
import Button from '../../components/Button.astro';
import { loadAllAugmentedFarms, getStatesWithFarms } from '../../lib/farm-loader';

// "Berries" spans several crops. This aggregate page lists every farm that
// grows at least one berry, grouped by state, so the umbrella query
// ("berry picking farms near me") has a single directory answer instead of
// forcing visitors to check each berry crop page separately.

const BERRY_RE = /blueberr|strawberr|blackberr|raspberr|boysenberr/i;
const isBerry = (f: any) => (f.produce || f.crops || []).some((c: string) => BERRY_RE.test(String(c)));

const allFarms = loadAllAugmentedFarms();
const berryFarms = allFarms.filter(isBerry);

// Per-berry crop counts, for the "pick a berry" chips.
const berryCounts: Record<string, number> = {};
for (const f of berryFarms) {
  for (const c of (f.produce || f.crops || [])) {
    if (BERRY_RE.test(String(c))) berryCounts[String(c)] = (berryCounts[String(c)] || 0) + 1;
  }
}
const berryCrops = Object.entries(berryCounts).sort((a, b) => b[1] - a[1]);

const inSeasonFarms = berryFarms.filter((f) => f.derivedInSeasonNow);

// Farm counts per state, for the "browse by state" chips.
const byState: Record<string, number> = {};
for (const f of berryFarms) byState[f.locationState] = (byState[f.locationState] || 0) + 1;
const stateNameMap = Object.fromEntries(getStatesWithFarms().map((s) => [s.code, s.name]));
const states = Object.entries(byState).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const sortedFarms = [...berryFarms].sort(
  (a, b) => (b.derivedInSeasonNow ? 1 : 0) - (a.derivedInSeasonNow ? 1 : 0) || a.name.localeCompare(b.name),
);
const stateCount = states.length;
---

<BaseLayout
  active="farms"
  title="Berry Picking Farms · HarvestMap"
  description={`${berryFarms.length} u-pick berry farms across ${stateCount} states. Find strawberry, blueberry, raspberry, and blackberry farms near you.`}
>
  <div class="container" style="padding-top: var(--space-6);">
    <a href="/crops" class="btn btn--ghost" style="margin-bottom: var(--space-4);">&larr; All crops</a>

    <div class="section-head" style="margin-bottom: var(--space-6);">
      <span class="eyebrow"><Leaf class="is-drawn" style="width:18px;height:18px;" /> {berryFarms.length} farms · {stateCount} states</span>
      <h1 class="squiggle squiggle-berry">Berry picking farms</h1>
      <p class="lead">
        {berryFarms.length} farms growing berries across {stateCount} states.
        {inSeasonFarms.length > 0 && <strong style="color: var(--moss);"> {inSeasonFarms.length} are harvesting right now.</strong>}
      </p>
    </div>

    <div class="panel panel--feature" style="margin-bottom: var(--space-6); padding: var(--space-5);">
      <div class="cluster" style="justify-content: space-between; flex-wrap: wrap; gap: var(--space-4);">
        <div class="stack stack-2">
          <span class="eyebrow">Harvest guide</span>
          <h2 style="margin: 0; font-family: var(--font-display); font-size: var(--fs-h3);">Berry Picking Farms Near You</h2>
          <p style="color: var(--text-muted); margin: 0; max-width: 50ch;">When each berry ripens state by state, what to bring, and what it costs.</p>
        </div>
        <Button variant="primary" href="/guides/berry-picking-farms-near-you">Read the guide &rarr;</Button>
      </div>
    </div>

    {berryCrops.length > 0 && (
      <section style="margin-bottom: var(--space-6);">
        <h2 style="font-size: var(--fs-h3); margin-bottom: var(--space-3);">Pick a berry</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: var(--space-3);">
          {berryCrops.map(([crop, count]) => (
            <a href={`/crops/${crop.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="card" style="text-decoration: none; padding: var(--space-3) var(--space-4);">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 600; font-family: var(--font-display);">{crop}</span>
                <span class="code-pill">{count}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {states.length > 0 && (
      <section style="margin-bottom: var(--space-7);">
        <h2 style="font-size: var(--fs-h3); margin-bottom: var(--space-3);">Browse by state</h2>
        <div class="cluster" style="gap: var(--space-2);">
          {states.map(([code, count]) => (
            <a href={`/${code.toLowerCase()}`} class="code-pill" style="text-decoration: none;">
              {stateNameMap[code] || code} · {count}
            </a>
          ))}
        </div>
      </section>
    )}

    {inSeasonFarms.length > 0 && (
      <section style="margin-bottom: var(--space-7);">
        <div class="section-head" style="margin-bottom: var(--space-4);">
          <h2 style="font-size: var(--fs-h3); display: flex; align-items: center; gap: var(--space-2);">
            <span class="live-dot"></span> Harvesting now
          </h2>
          <p style="color: var(--text-muted); font-size: var(--fs-small); margin: 0;">{inSeasonFarms.length} berry farms currently in season.</p>
        </div>
        <div class="farm-list">
          {inSeasonFarms.slice(0, 12).map((f) => <FarmRow farm={f} />)}
        </div>
      </section>
    )}

    <section>
      <div class="section-head" style="margin-bottom: var(--space-4);">
        <h2 style="font-size: var(--fs-h3);">All berry farms</h2>
        <p style="color: var(--text-muted); font-size: var(--fs-small); margin: 0;">Across {states.map(([code]) => code).join(', ')}</p>
      </div>
      <div class="farm-list">
        {sortedFarms.slice(0, 24).map((f) => <FarmRow farm={f} />)}
      </div>
      {sortedFarms.length > 24 && (
        <p style="text-align: center; margin-top: var(--space-4); color: var(--text-muted);">
          Showing 24 of {sortedFarms.length} berry farms. <a href="/u-pick-farms" style="color: var(--clay-deep);">Use the finder to search by location &rarr;</a>
        </p>
      )}
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'Crops', item: '/crops' },
      { '@type': 'ListItem', position: 3, name: 'Berries', item: '/crops/berries' },
    ],
  })} />
</BaseLayout>
