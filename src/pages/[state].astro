---
import BaseLayout from '../layouts/BaseLayout.astro';
import FarmRow from '../components/FarmRow.astro';
import SeasonBadge from '../components/SeasonBadge.astro';
import Button from '../components/Button.astro';
import Leaf from '../components/illustrations/Leaf.astro';
import {
  getStatesWithFarms,
  loadFarmsByState,
  augmentFarm,
} from '../lib/farm-loader';
import { FEATURE_COLLECTIONS } from '../lib/collections';
import { isIndexable, MIN_ENRICHED_TO_PUBLISH } from '../lib/indexing';
import { getStateIntro } from '../lib/state-intros';

export function getStaticPaths() {
  const states = getStatesWithFarms().filter((s) => s.enriched >= MIN_ENRICHED_TO_PUBLISH);
  return states.map((s) => ({
    params: { state: s.code.toLowerCase() },
    props: { stateCode: s.code, stateName: s.name, totalCount: s.count, enrichedCount: s.enriched },
  }));
}

const { stateCode, stateName, totalCount, enrichedCount } = Astro.props;
const stateFarms = loadFarmsByState(stateCode).map(augmentFarm);

// Only enriched (indexable) farms get a listing row; bare listings are hidden
// and summarized as "Plus N more".
const indexableFarms = stateFarms
  .filter((f) => isIndexable(f) && !f.permanentlyClosed)
  .sort((a, b) => {
    const aRich = (a.produce || a.crops || []).length;
    const bRich = (b.produce || b.crops || []).length;
    if (aRich !== bRich) return bRich - aRich;
    return a.name.localeCompare(b.name);
  });
const bareCount = stateFarms.length - indexableFarms.length;

// Fall collections (corn mazes, haunted patches) with at least one match here.
const stateCollections = FEATURE_COLLECTIONS
  .map((c) => ({ ...c, count: stateFarms.filter((f) => !f.permanentlyClosed && c.predicate(f)).length }))
  .filter((c) => c.count > 0);


// What's in season right now in this state
const inSeasonFarms = stateFarms.filter((f) => f.derivedInSeasonNow);
const inSeasonCrops = [...new Set(
  inSeasonFarms.flatMap((f) => f.produce || f.crops || [])
)].sort();

// Popular crops in this state (by farm count)
const cropCounts: Record<string, number> = {};
for (const f of stateFarms) {
  for (const c of (f.produce || f.crops || [])) {
    cropCounts[c] = (cropCounts[c] || 0) + 1;
  }
}
const topCrops = Object.entries(cropCounts).sort((a, b) => b[1] - a[1]).slice(0, 12);

// State-specific intro: season calendar + regional highlights + don't-miss farms.
const typeCounts = {
  agritourism: stateFarms.filter((f) => f.directory === 'agritourism').length,
  markets: stateFarms.filter((f) => f.directory === 'farmersmarket').length,
  stands: stateFarms.filter((f) => f.directory === 'onfarmmarket').length,
  csa: stateFarms.filter((f) => f.directory === 'csa').length,
};

const stateIntro = getStateIntro(
  stateCode,
  stateName,
  totalCount,
  topCrops.map(([crop]) => crop),
  typeCounts,
  stateFarms.map((f) => ({
    name: f.name,
    slug: f.slug,
    crops: f.produce || f.crops || [],
    isEnriched: isIndexable(f),
  })),
);
---
<BaseLayout active="farms" title={`U-Pick Farms in ${stateName} · HarvestMap`} description={`${totalCount} farms and growers in ${stateName}. Find u-pick farms, farm stands, orchards, and farmers markets near you.`}>
  <div class="container" style="padding-top: var(--space-6);">
    <a href="/#states" class="btn btn--ghost" style="margin-bottom: var(--space-4);">&larr; All states</a>

    <div class="section-head" style="margin-bottom: var(--space-6);">
      <span class="eyebrow"><Leaf class="is-drawn" style="width:18px;height:18px;" /> {stateName}</span>
      <h1 class="squiggle squiggle-harvest">Farms in {stateName}</h1>
      <p class="lead">{totalCount} farms listed · {enrichedCount} enriched</p>
    </div>

    {stateIntro.paragraphs.length > 0 && (
      <section style="margin-bottom: var(--space-6);">
        <div class="prose" style="max-width: 72ch;">
          {stateIntro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        {stateIntro.highlightFarms.length > 0 && (
          <div style="margin-top: var(--space-4);">
            <span class="eyebrow">Don't miss</span>
            <div class="cluster" style="gap: var(--space-2); margin-top: var(--space-2);">
              {stateIntro.highlightFarms.map((f) => (
                <a href={`/farms/${stateCode.toLowerCase()}/${f.slug}`} class="chip" style="text-decoration: none;">{f.name}</a>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    {inSeasonCrops.length > 0 && (
      <section style="margin-bottom: var(--space-6);">
        <div class="panel panel--feature" style="padding: var(--space-4);">
          <h2 style="font-size: var(--fs-h3); display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3);">
            <span class="live-dot"></span> What's ripe in {stateName} now
          </h2>
          <div class="cluster" style="gap: var(--space-2);">
            {inSeasonCrops.map((crop) => (
              <a href={`/crops/${crop.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="code-pill" style="text-decoration: none; background: color-mix(in srgb, var(--moss) 15%, var(--surface));">{crop}</a>
            ))}
          </div>
        </div>
      </section>
    )}

    {topCrops.length > 0 && (
      <section style="margin-bottom: var(--space-6);">
        <div class="section-head" style="margin-bottom: var(--space-3);">
          <h2 style="font-size: var(--fs-h3);">Popular crops in {stateName}</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-3);">
          {topCrops.map(([crop, count]) => (
            <a href={`/crops/${crop.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="card" style="text-decoration: none; padding: var(--space-3) var(--space-4);">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 600; font-family: var(--font-display);">{crop}</span>
                <span class="code-pill">{count}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {stateCollections.length > 0 && (
      <section style="margin-bottom: var(--space-6);">
        <div class="section-head" style="margin-bottom: var(--space-3);">
          <h2 style="font-size: var(--fs-h3);">Seasonal collections in {stateName}</h2>
        </div>
        <div class="cluster" style="gap: var(--space-2);">
          {stateCollections.map((c) => (
            <a href={`/features/${c.id}/${stateCode.toLowerCase()}`} class="chip" style="text-decoration: none;">{c.icon} {c.label} · {c.count}</a>
          ))}
        </div>
      </section>
    )}

    {indexableFarms.length > 0 && (
      <section>
        <div class="section-head" style="margin-bottom: var(--space-4);">
          <h2 style="font-size: var(--fs-h3);">Farms in {stateName}</h2>
          <p style="color: var(--text-muted); font-size: var(--fs-small); margin: 0;">{indexableFarms.length} farms with verified details.</p>
        </div>
        <div class="farm-list">
          {indexableFarms.map((f) => <FarmRow farm={f} />)}
        </div>
        {bareCount > 0 && (
          <p style="color: var(--text-muted); font-size: var(--fs-small); margin: var(--space-3) 0 0;">
            Plus {bareCount} more listings without verified details yet.
          </p>
        )}
      </section>
    )}

    {stateFarms.length === 0 && (
      <div class="panel" style="padding: var(--space-6); text-align: center;">
        <p style="color: var(--text-muted);">No farms found for {stateName} yet.</p>
      </div>
    )}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
      { '@type': 'ListItem', position: 2, name: `${stateName} Farms`, item: `/${stateCode.toLowerCase()}` },
    ],
  })} />
</BaseLayout>
