---
// CSS-only falling leaves animation. 18 SVG leaves with unique
// animation durations, delays, positions, and drift paths.
// Replaces three.js (~600KB) with ~2KB of SVG + CSS.
const leaves = [
  { left: '5%',  dur: '11s', delay: '0s',   xStart: '0px',   xMid: '40px',  xEnd: '-20px', opacity: 0.5, color: '#7D8B6F' },
  { left: '12%', dur: '14s', delay: '2s',   xStart: '20px',  xMid: '-30px', xEnd: '10px',  opacity: 0.4, color: '#C4632C' },
  { left: '18%', dur: '9s',  delay: '4s',   xStart: '-10px', xMid: '25px',  xEnd: '40px',  opacity: 0.6, color: '#E3A63B' },
  { left: '25%', dur: '13s', delay: '1s',   xStart: '15px',  xMid: '-20px', xEnd: '-10px', opacity: 0.3, color: '#7D8B6F' },
  { left: '32%', dur: '10s', delay: '5s',   xStart: '-5px',  xMid: '35px',  xEnd: '20px',  opacity: 0.5, color: '#C4632C' },
  { left: '38%', dur: '15s', delay: '3s',   xStart: '10px',  xMid: '-15px', xEnd: '30px',  opacity: 0.4, color: '#E3A63B' },
  { left: '45%', dur: '12s', delay: '6s',   xStart: '0px',   xMid: '20px',  xEnd: '-25px', opacity: 0.5, color: '#7D8B6F' },
  { left: '52%', dur: '8s',  delay: '2.5s', xStart: '-20px', xMid: '30px',  xEnd: '5px',   opacity: 0.6, color: '#C4632C' },
  { left: '58%', dur: '14s', delay: '7s',   xStart: '15px',  xMid: '-25px', xEnd: '-15px', opacity: 0.3, color: '#E3A63B' },
  { left: '65%', dur: '11s', delay: '4.5s', xStart: '-10px', xMid: '40px',  xEnd: '25px',  opacity: 0.5, color: '#7D8B6F' },
  { left: '72%', dur: '13s', delay: '0.5s', xStart: '20px',  xMid: '-10px', xEnd: '-30px', opacity: 0.4, color: '#C4632C' },
  { left: '78%', dur: '10s', delay: '3.5s', xStart: '0px',   xMid: '25px',  xEnd: '10px',  opacity: 0.5, color: '#E3A63B' },
  { left: '85%', dur: '12s', delay: '5.5s', xStart: '-15px', xMid: '-20px', xEnd: '20px',  opacity: 0.4, color: '#7D8B6F' },
  { left: '92%', dur: '9s',  delay: '1.5s', xStart: '10px',  xMid: '35px',  xEnd: '-10px', opacity: 0.6, color: '#C4632C' },
  { left: '8%',  dur: '15s', delay: '8s',   xStart: '5px',   xMid: '-30px', xEnd: '15px',  opacity: 0.3, color: '#E3A63B' },
  { left: '28%', dur: '10s', delay: '6.5s', xStart: '-20px', xMid: '15px',  xEnd: '30px',  opacity: 0.4, color: '#7D8B6F' },
  { left: '48%', dur: '13s', delay: '9s',   xStart: '15px',  xMid: '-20px', xEnd: '-5px',  opacity: 0.3, color: '#C4632C' },
  { left: '68%', dur: '11s', delay: '7.5s', xStart: '0px',   xMid: '30px',  xEnd: '-20px', opacity: 0.5, color: '#E3A63B' },
];
---
<div class="leaf-field" aria-hidden="true">
  {leaves.map((l) => (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke={l.color}
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      style={`left: ${l.left}; --leaf-dur: ${l.dur}; --leaf-delay: ${l.delay}; --leaf-x-start: ${l.xStart}; --leaf-x-mid: ${l.xMid}; --leaf-x-end: ${l.xEnd}; --leaf-opacity: ${l.opacity};`}
    >
      <path d="M12 2 C8 6 6 12 8 18 C10 20 14 20 16 18 C18 12 16 6 12 2 Z" fill={l.color} fill-opacity="0.15" />
      <path d="M12 2 L12 22" />
      <path d="M12 8 L9 6" />
      <path d="M12 11 L15 9" />
      <path d="M12 14 L9 12" />
      <path d="M12 17 L15 15" />
    </svg>
  ))}
</div>
