---
interface Props { active?: 'home' | 'farms' | 'seasons' | 'states' | 'blog' | ''; }
const { active = '' } = Astro.props;

const links = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'farms', label: 'Browse farms', href: '/#directory' },
  { id: 'seasons', label: "What's in season", href: '/#seasons' },
  { id: 'states', label: 'By state', href: '/#states' },
  { id: 'blog', label: 'Blog', href: '/blog' },
];
---
<header class="nav">
  <div class="container nav__inner">
    <a class="brand" href="/" aria-label="HarvestMap home">
      <svg class="brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M5 13h22l-2 11.4a2.5 2.5 0 0 1-2.5 2.1H9.5A2.5 2.5 0 0 1 7 24.4L5 13Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        <path d="M10.5 13 15 4M21.5 13 17 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M16 6c1.8-2.3 4.6-2.6 6.4-1.6" stroke="#8A9A5B" stroke-width="2" stroke-linecap="round"/>
        <circle cx="12.5" cy="18.5" r="1.6" fill="#F2A65A"/>
        <circle cx="19.5" cy="18.5" r="1.6" fill="#8C3A52"/>
      </svg>
      <span>Harvest<b>Map</b></span>
    </a>

    <nav class="nav__links" id="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a
          class="nav__link"
          href={l.href}
          aria-current={active === l.id ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </nav>

    <div class="nav__actions">
      <button class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"/>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4 6.3 6.3 0 0 0 20 14.5Z"/>
        </svg>
      </button>
      <button class="nav__toggle" data-nav-toggle aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </div>
</header>
