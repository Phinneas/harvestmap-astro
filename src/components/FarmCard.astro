---
import SeasonBadge from './SeasonBadge.astro';
import type { Farm, Season } from '../lib/types';

interface AugmentedFarm extends Farm {
  derivedSeasons: Season[];
  derivedPeak?: Season;
  derivedInSeasonNow: boolean;
  isEnriched: boolean;
}

interface Props { farm: AugmentedFarm; }
const { farm } = Astro.props;

const peakLabels = { spring: 'Spring', summer: 'Summer', autumn: 'Autumn', winter: 'Winter', year: 'Year-round' };
const seasons = farm.seasons && farm.seasons.length > 0 ? farm.seasons : farm.derivedSeasons;
const peak = farm.peak || farm.derivedPeak;
const inSeasonNow = farm.inSeasonNow !== undefined ? farm.inSeasonNow : farm.derivedInSeasonNow;
const produce = farm.produce || farm.crops || [];
const produceKey = produce.join(' ').toLowerCase();
const region = farm.region || farm.directory;
const image = farm.image || '/images/farm-placeholder.svg';
const imageAlt = farm.imageAlt || farm.name;
const tagline = farm.tagline || (produce.length > 0 ? `U-pick: ${produce.slice(0, 3).join(', ')}` : 'Farm listing');
---
<article
  class="card"
  data-seasons={seasons.join(' ')}
  data-name={farm.name.toLowerCase()}
  data-produce={produceKey}
>
  {peak && (
    <span class="pin-badge">
      <SeasonBadge season={peak} label={`${peakLabels[peak]} peak`} />
    </span>
  )}

  <div class="card__media">
    <img
      class="card__img"
      src={image}
      alt={imageAlt}
      width="600"
      height="450"
      loading="lazy"
      decoding="async"
    />
    {inSeasonNow && peak && (
      <div class="card__badges">
        <SeasonBadge season={peak} label="In season now" />
      </div>
    )}
  </div>

  <div class="card__body">
    <span class="card__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 21c5-3 8-7 8-11a8 8 0 1 0-16 0c0 4 3 8 8 11Z"/><path d="M12 11v0"/>
      </svg>
      {region}
    </span>
    <h3 class="card__title"><a href={`/farms/${farm.slug}`}>{farm.name}</a></h3>
    <p class="card__desc">{tagline}</p>
    {produce.length > 0 && (
      <div class="card__tags">
        {produce.slice(0, 4).map((p) => <span class="tag">{p}</span>)}
      </div>
    )}
  </div>

  <div class="card__foot">
    <span class="card__loc">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 21c5-3 8-7 8-11a8 8 0 1 0-16 0c0 4 3 8 8 11Z"/><circle cx="12" cy="10" r="2.6"/>
      </svg>
      {farm.location}
    </span>
    <span aria-hidden="true" style="font-weight:600;font-size:var(--fs-small);color:var(--clay-deep);">View →</span>
  </div>
</article>
