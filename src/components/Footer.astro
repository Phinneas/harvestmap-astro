---
const year = new Date().getFullYear();
---
<footer class="footer-redesign">
  <div class="container footer__inner" style="grid-template-columns: 1.4fr 1fr 1fr;">
    <div class="footer__brandcol">
      <a class="brand" href="/" aria-label="HarvestMap home" style="color: var(--text-invert);">
        <svg class="brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true" style="color: var(--honey);">
          <path d="M5 13h22l-2 11.4a2.5 2.5 0 0 1-2.5 2.1H9.5A2.5 2.5 0 0 1 7 24.4L5 13Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M10.5 13 15 4M21.5 13 17 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="12.5" cy="18.5" r="1.6" fill="var(--peach)"/>
          <circle cx="19.5" cy="18.5" r="1.6" fill="var(--berry)"/>
        </svg>
        <span>Harvest<b style="color: var(--honey);">Map</b></span>
      </a>
      <p style="color: rgba(255,255,255,0.6); max-width: 34ch;">Find what's ripe near you. A community directory of small farms, orchards, and growers.</p>
    </div>

    <div>
      <h4>Explore</h4>
      <div class="footer__links">
        <a href="/#finder">Browse farms</a>
        <a href="/#seasons">What's in season</a>
        <a href="/#states">By state</a>
        <a href="/guides">Guides</a>
        <a href="/search">Search</a>
        <a href="/blog">Blog</a>
      </div>
    </div>

    <div>
      <h4>For growers</h4>
      <div class="footer__links">
        <a href="/add-farm">List your farm</a>
        <a href="/report">Update your harvest</a>
        <a href="/growers">Grower handbook</a>
        <a href="/admin/review" style="opacity: 0.5;">Admin</a>
      </div>
    </div>
  </div>

  <div class="container footer__legal" style="border-color: rgba(255,255,255,0.1);">
    <span>&copy; {year} HarvestMap · A product of <a href="https://www.salishseaconsulting.com" rel="noopener" style="color: var(--honey); text-decoration: none;">Salish Sea Consulting</a></span>
    <span style="font-style: italic;">Grown with sun, soil &amp; a little whimsy.</span>
  </div>
</footer>
