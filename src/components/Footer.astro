---
import SwayingTrees from './illustrations/SwayingTrees.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <SwayingTrees class="footer__trees" />
  <div class="container footer__inner">
    <div class="footer__brandcol">
      <a class="brand" href="/" aria-label="HarvestMap home">
        <svg class="brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M5 13h22l-2 11.4a2.5 2.5 0 0 1-2.5 2.1H9.5A2.5 2.5 0 0 1 7 24.4L5 13Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M10.5 13 15 4M21.5 13 17 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="12.5" cy="18.5" r="1.6" fill="#F2A65A"/>
          <circle cx="19.5" cy="18.5" r="1.6" fill="#8C3A52"/>
        </svg>
        <span>Harvest<b>Map</b></span>
      </a>
      <p class="muted">Find what’s ripe near you. A community directory of small farms, orchards, and growers — sorted by what they’re harvesting right now.</p>
    </div>

    <div>
      <h4>Explore</h4>
      <div class="footer__links">
        <a href="/#directory">Browse farms</a>
        <a href="/#seasons">What's in season</a>
        <a href="/#states">By state</a>
        <a href="/blog">Blog</a>
      </div>
    </div>

    <div>
      <h4>For growers</h4>
      <div class="footer__links">
        <a href="/#directory">List your farm</a>
        <a href="/#directory">Update your harvest</a>
        <a href="/#directory">Grower handbook</a>
        <a href="/#directory">Contact</a>
      </div>
    </div>
  </div>

  <div class="container footer__legal">
    <span>© {year} HarvestMap. A demonstration of the HarvestMap design system.</span>
    <span>Grown with sun, soil &amp; a little whimsy.</span>
  </div>
</footer>
