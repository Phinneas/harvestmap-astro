---
// A single tile of the farm panorama. Rendered side-by-side several times by
// FarmMarquee.astro and scrolled horizontally for a seamless loop.
// Style matches the HarvestMap hand-drawn illustration set (ill--stroke),
// with moss / berry / honey / peach accents for color pops.
---
<svg
  viewBox="0 0 2000 150"
  class="farm-scene ill ill--stroke"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
>
  <!-- ===== Sky ===== -->
  <circle class="accent--honey" cx="150" cy="46" r="18" />
  <path d="M150 16 v-8 M150 76 v-8 M120 46 h-8 M180 46 h-8 M128 25 l-6 -6 M172 67 l6 6 M172 25 l6 -6 M128 67 l-6 6" />

  <path d="M340 46 c-10 -1 -16 -9 -12 -17 c-3 -9 4 -17 13 -17 c5 -7 14 -8 20 -3 c7 -3 15 1 17 8 c9 0 14 8 10 15 c2 7 -5 14 -12 14 Z" />
  <path d="M1830 40 c-9 -1 -15 -8 -11 -15 c-3 -8 4 -15 12 -15 c4 -6 12 -7 17 -3 c6 -3 13 1 15 7 c8 0 12 7 9 13 c2 6 -4 12 -11 13 Z" />

  <!-- ===== Rolling hills + ground ===== -->
  <path d="M0 96 Q240 76 500 92 T1000 88 T1500 96 T2000 86" opacity="0.5" />
  <path d="M0 110 Q260 92 540 104 T1080 102 T1560 108 T2000 100" opacity="0.7" />
  <path d="M0 120 Q500 116 1000 120 T2000 120" />

  <!-- crop rows / furrows -->
  <path d="M140 120 q6 -8 0 -16 M180 120 q6 -8 0 -16 M220 120 q6 -8 0 -16 M260 120 q6 -8 0 -16 M300 120 q6 -8 0 -16 M340 120 q6 -8 0 -16 M380 120 q6 -8 0 -16 M420 120 q6 -8 0 -16 M460 120 q6 -8 0 -16 M500 120 q6 -8 0 -16 M540 120 q6 -8 0 -16" opacity="0.6" />

  <!-- ===== Fence ===== -->
  <path d="M1640 112 h120 M1640 103 h120 M1642 118 v-10 M1680 118 v-10 M1718 118 v-10 M1756 118 v-10" />

  <!-- ===== Barn + silo ===== -->
  <g>
    <!-- walls -->
    <path d="M700 120 v-34 h70 v34" />
    <!-- gambrel roof -->
    <path class="accent--berry" d="M694 86 L720 70 L735 78 L750 70 L776 86 Z" />
    <!-- door -->
    <path d="M724 120 v-17 h22 v17 M735 103 v17" />
    <!-- loft window -->
    <circle cx="735" cy="93" r="3" />
    <!-- silo -->
    <path d="M790 120 v-40 a8 8 0 0 1 16 0 v40 M790 100 h16" />
  </g>

  <!-- ===== Tractor ===== -->
  <g>
    <path class="accent--honey" d="M904 116 v-14 h44 v14 z" />
    <path d="M918 102 v-10 h18 v10 M904 116 h44" />
    <circle cx="912" cy="113" r="11" />
    <circle cx="912" cy="113" r="4" />
    <circle cx="948" cy="120" r="6" />
    <path d="M956 120 l8 0" />
  </g>

  <!-- ===== Trees (canopies sway) ===== -->
  <g>
    <path d="M520 120 v-24" />
    <g class="sway">
      <path class="accent--moss" d="M520 92 c-16 -9 -16 -30 0 -35 c-5 -14 7 -27 21 -27 c7 -10 21 -10 26 0 c14 0 24 13 19 27 c16 5 16 26 0 35 c-20 12 -46 12 -66 0 Z" />
      <path d="M520 84 c-8 -4 -8 -16 0 -20 M520 60 l0 8 M536 74 l6 -4 M504 74 l-6 -4" />
    </g>
  </g>
  <g>
    <path d="M1010 120 v-20" />
    <g class="sway sway-2">
      <path class="accent--moss" d="M1010 96 c-13 -7 -13 -24 0 -28 c-4 -11 6 -21 17 -21 c6 -8 17 -8 21 0 c11 0 19 10 15 21 c13 4 13 21 0 28 c-16 9 -37 9 -53 0 Z" />
    </g>
  </g>
  <g>
    <path d="M1330 120 v-26" />
    <g class="sway sway-3">
      <path class="accent--moss" d="M1330 88 c-18 -10 -18 -33 0 -39 c-6 -15 8 -30 23 -30 c8 -11 23 -11 29 0 c15 0 26 14 21 30 c18 6 18 29 0 39 c-22 13 -51 13 -73 0 Z" />
    </g>
  </g>

  <!-- ===== Animals ===== -->
  <!-- cow -->
  <g>
    <path d="M286 120 v-8 M300 120 v-9 M318 120 v-9 M332 120 v-8" />
    <path d="M270 106 Q300 97 332 106 Q340 108 338 112 Q300 118 270 112 Q262 110 270 106 Z" />
    <path d="M268 100 Q256 95 254 102 Q257 108 268 109" />
    <circle class="accent" cx="258" cy="98" r="2.4" />
    <circle cx="290" cy="104" r="3" style="fill:var(--bark);stroke:none;" />
    <circle cx="318" cy="105" r="2.6" style="fill:var(--bark);stroke:none;" />
  </g>

  <!-- pig -->
  <g>
    <path d="M428 120 v-7 M444 120 v-7 M436 120 v-8" />
    <path d="M414 108 Q440 98 464 108 Q470 112 466 116 Q440 122 416 116 Q410 112 414 108 Z" />
    <circle cx="466" cy="104" r="6" />
    <path d="M470 104 q4 -1 3 -4 M468 110 l6 1" />
    <circle cx="458" cy="102" r="1.2" />
  </g>

  <!-- chicken -->
  <g class="bob">
    <path d="M1076 120 v-8 M1088 120 v-8" />
    <path d="M1072 108 q12 -10 24 -2 q4 -8 12 -6 q-2 8 2 12 q8 0 4 8 q-8 4 -12 0 q-6 6 -12 4 q-10 4 -18 -2 Z" />
    <path class="accent--berry" d="M1078 98 q2 -7 -2 -10 q-1 5 -4 6 q2 3 6 4 Z" />
    <path d="M1098 110 l8 -3 M1098 112 l8 2" />
  </g>

  <!-- sheep -->
  <g>
    <path d="M1258 120 v-8 M1274 120 v-8 M1266 120 v-9" />
    <path d="M1244 108 c0 -12 12 -18 22 -14 c6 -8 20 -6 24 2 c12 -2 20 6 16 16 c-2 6 -8 10 -14 10 c-8 4 -16 4 -24 0 c-10 0 -18 -6 -24 -14 Z" />
    <path d="M1302 104 q10 -2 10 6 q-4 2 -8 0" />
    <circle cx="1304" cy="100" r="1.2" />
  </g>

  <!-- horse -->
  <g>
    <path d="M1428 120 v-9 M1442 120 v-9 M1452 120 v-8" />
    <path d="M1420 108 Q1436 100 1452 106 Q1456 108 1454 112 Q1438 117 1422 112 Q1418 110 1420 108 Z" />
    <path d="M1452 106 q10 -4 12 -14 q-2 -8 -8 -6 l-6 8" />
    <path d="M1446 96 q2 -8 8 -6" />
    <path d="M1420 106 q-8 -2 -12 2 q2 4 6 3" />
  </g>

  <!-- duck -->
  <g class="bob bob-2">
    <path d="M1568 120 v-6 M1578 120 v-6" />
    <path d="M1560 112 q12 -8 22 2 q4 -2 8 0 q2 3 -2 4 q6 4 2 8 q-8 2 -12 -2 q-10 4 -18 -2 Z" />
    <path class="accent--honey" d="M1582 110 q4 -3 8 -1 q-2 3 -6 3 Z" />
    <circle cx="1582" cy="108" r="1.2" />
  </g>
</svg>
