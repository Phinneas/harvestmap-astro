  <path d="M30 70 C40 46 46 28 50 14" pathLength="1" />
  <path d="M33 56 L23 58" pathLength="1" />
  <path d="M37 45 L27 44" pathLength="1" />
  <path d="M42 34 L33 31" pathLength="1" />
  <path d="M38 62 L48 57" pathLength="1" />
