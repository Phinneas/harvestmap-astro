---
interface Props { class?: string; label?: string; }
const { class: className = '', label } = Astro.props;
---
<svg
  viewBox="0 0 80 80"
  class={`ill ill--stroke ${className}`}
  fill="none"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path class="accent--moss" d="M40 8 C18 22 14 52 30 72 C50 60 66 34 54 14 C50 9 45 7 40 8 Z" pathLength="1" />
