---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HarvestMap — Find what's ripe near you",
  description = "See what's in season near you this week and find the closest farms, markets and CSAs picking it.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <link rel="stylesheet" href="./hm.css" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
