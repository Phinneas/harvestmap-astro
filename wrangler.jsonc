{
  "name": "harvestmap",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SUBMISSIONS_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ]
}
