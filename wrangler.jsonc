{
	"name": "harvestmap",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "dist/_worker.js/index.js",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SUBMISSIONS_KV",
			"id": "7e2bd73b4984476197c4f6e09425deb2"
		}
	]
}